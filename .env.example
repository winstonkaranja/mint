# Base URL of the deployed server (no trailing slash)
MINT_BASE_URL=http://localhost:8000

# Secret key for JWT signing (any long random string)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MINT_SECRET_KEY=

# Google OAuth — https://console.cloud.google.com/apis/credentials
MINT_GOOGLE_CLIENT_ID=
MINT_GOOGLE_CLIENT_SECRET=

# Microsoft / Azure OAuth — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Required scopes: Mail.Read, Mail.ReadWrite, Calendars.ReadWrite, offline_access
MINT_AZURE_CLIENT_ID=
MINT_AZURE_CLIENT_SECRET=
MINT_AZURE_TENANT_ID=
