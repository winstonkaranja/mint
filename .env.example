# Provider: "google" or "microsoft"
MINT_PROVIDER=google
MINT_BASE_URL=http://localhost:8000

# Google OAuth (required when MINT_PROVIDER=google)
MINT_GOOGLE_CLIENT_ID=
MINT_GOOGLE_CLIENT_SECRET=

# Microsoft / Azure OAuth (required when MINT_PROVIDER=microsoft)
# Requires scopes: Mail.Read, Mail.ReadWrite, Calendars.ReadWrite, offline_access
MINT_AZURE_CLIENT_ID=
MINT_AZURE_CLIENT_SECRET=
MINT_AZURE_TENANT_ID=
